SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# Optional: for seed_dev_user.py only — never commit the real key
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Claude API — content gap analysis and brief generation (server-side only)
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
# ANTHROPIC_BRIEF_MODEL=claude-haiku-4-5
# ANTHROPIC_GAP_MODEL=claude-haiku-4-5
# ANTHROPIC_DRAFT_MODEL=claude-sonnet-4-5

# Page auditor MCP service
PAGE_AUDITOR_URL=http://127.0.0.1:3001

# SERP + competitor analysis MCP services
SERP_URL=http://127.0.0.1:3002
COMPETITOR_ANALYSIS_URL=http://127.0.0.1:3003
# SERP_API_KEY=...  # set on mcp/serp process
# OPENAI_API_KEY=...  # embeddings (content gap fallback + SR-02 clustering)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# SR-02 semantic keyword clustering
KEYWORD_RESEARCH_URL=http://127.0.0.1:3007
# ANTHROPIC_CLUSTER_MODEL=claude-haiku-4-5

# Search Console MCP + GSC OAuth (SR-01)
SEARCH_CONSOLE_URL=http://127.0.0.1:3006
# GSC_CLIENT_ID=...
# GSC_CLIENT_SECRET=...
# GSC_REDIRECT_URI=http://localhost:3000/api/auth/gsc/callback
# TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
# FRONTEND_URL=http://localhost:3000

# Local dev auth bypass (never enable in production)
# DEV_AUTH_BYPASS=true
# DEV_AUTH_USER_ID=uuid-from-seed_dev_user.py
# DEV_AUTH_EMAIL=dev@example.com
# DEV_AUTH_TOKEN=rankforge-dev-local

# FR-07 weekly keyword ranking job (APScheduler). Set false in tests.
# ENABLE_KEYWORD_RANKING_SCHEDULER=true
